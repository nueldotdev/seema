VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional: skips sign-in only on localhost with `npm run dev`. Demo data stays in browser storage.
VITE_LOCAL_DEMO=false

# Server-only variables for Vercel Functions/local `vercel dev`.
# Never rename these secrets to VITE_*; VITE_* variables are bundled into the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CRON_SECRET=
MARK_READ_SECRET=
APP_URL=